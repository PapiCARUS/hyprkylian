{
 "layer": "top", "position": "bottom", "height": 44,
 "modules-left": ["custom/cat", "hyprland/workspaces"],
 "modules-center": ["clock"],
 "modules-right": ["cpu", "memory", "network"],
 "custom/cat": {"format": "♡ kitty lab ♡", "tooltip": false, "on-click": "wofi --show drun"},
 "hyprland/workspaces": {"format": "{name}", "on-click": "activate"},
 "clock": {"format": "{:%H:%M  ✿  %d/%m}", "tooltip": false},
 "cpu": {"format": "CPU {usage}%"},
 "memory": {"format": "RAM {}%"},
 "network": {"format-ethernet": "♡ en ligne", "format-wifi": "♡ {signalStrength}%", "format-disconnected": "hors ligne"}
}
